NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sipadi:sipadi123@localhost:5432/sipadi
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_BASE64=
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
JWT_ISSUER=sipadi-api
JWT_AUDIENCE=sipadi-web
SESSION_COOKIE_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30
MAX_ACTIVE_SESSIONS=3
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_IMPORT_FILE_SIZE_MB=2
REQUEST_BODY_LIMIT_BYTES=262144
BCRYPT_ROUNDS=12
TRUST_PROXY_HOPS=0
SECURITY_BLOCK_THRESHOLD=5
SECURITY_STRIKE_WINDOW_MINUTES=15
SECURITY_BLOCK_DURATION_MINUTES=60
SECURITY_STATE_REQUIRED=false
SECURITY_STATE_REDIS_URL=
SECURITY_STATE_KEY_PREFIX=sipadi:security
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_WINDOW_MINUTES=15
ACCOUNT_LOCK_DURATION_MINUTES=15
PASSWORD_HISTORY_COUNT=5
PRIVILEGED_REAUTH_MAX_AGE_MINUTES=15
CRITICAL_APPROVAL_TTL_MINUTES=30
DATA_EGRESS_WINDOW_MINUTES=15
DATA_EGRESS_ALERT_THRESHOLD=20
DATA_EGRESS_BLOCK_THRESHOLD=40
DATA_EGRESS_BLOCK_MINUTES=60

# Gunakan kunci yang berbeda. Buat masing-masing dengan: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_ID=mfa-v1
MFA_PREVIOUS_ENCRYPTION_KEYS=
RECOVERY_CODE_PEPPER=
MFA_REQUIRED_ROLES=Admin,Inspektur
MFA_CHALLENGE_TTL_MINUTES=5
MFA_SETUP_TTL_MINUTES=10
PASSKEY_REQUIRED_ROLES=Admin,Inspektur
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SIPADI Inspektorat Kota Depok
WEBAUTHN_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_MINUTES=5

AUDIT_SIGNING_KEY=
AUDIT_SIGNING_KEY_ID=audit-v1
AUDIT_PREVIOUS_SIGNING_KEYS=
METRICS_ENABLED=true
METRICS_TOKEN=

BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=backup-v1
BACKUP_PREVIOUS_ENCRYPTION_KEYS=
ALLOW_PLAINTEXT_BACKUP_RESTORE=false
MAX_BACKUP_FILE_SIZE_MB=100

FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY_ID=file-v1
FILE_PREVIOUS_ENCRYPTION_KEYS=
FILE_ENCRYPTION_REQUIRED=false
ALLOW_PLAINTEXT_STORED_FILES=true
FILE_STORAGE_DRIVER=local
FILE_S3_BUCKET=
FILE_S3_REGION=ap-southeast-1
FILE_S3_PREFIX=sipadi/files
FILE_S3_ENDPOINT=
FILE_S3_FORCE_PATH_STYLE=false
FILE_S3_KMS_KEY_ID=
FILE_STORAGE_VERIFY_BUCKET_CONTROLS=false

# Semua secret di atas juga dapat dipasok sebagai NAMA_SECRET_FILE dari secret manager.
# Jangan mengisi NAMA_SECRET dan NAMA_SECRET_FILE secara bersamaan.

# Backup offsite S3-compatible. Gunakan IAM write-only dan Object Lock bila tersedia.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-southeast-1
BACKUP_S3_PREFIX=sipadi
BACKUP_S3_ENDPOINT=
BACKUP_S3_OBJECT_LOCK_DAYS=0

# Kosongkan CLAMAV_HOST saat development bila pemindaian belum digunakan.
# Di production, CLAMAV_REQUIRED default true dan upload akan fail-closed.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_REQUIRED=
SEED_DEFAULT_PASSWORD=SipadiDemo2026
