{
  "name": "@nova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest build && node --env-file ../../.env --import tsx dist/main.js",
    "build": "nest build",
    "start": "node --env-file ../../.env --import tsx dist/main.js",
    "start:dist": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test",
    "db:generate": "node --env-file ../../.env ./node_modules/prisma/build/index.js generate --config ../../prisma.config.ts --schema ../../prisma/schema.prisma",
    "db:migrate": "node --env-file ../../.env ./node_modules/prisma/build/index.js migrate dev --config ../../prisma.config.ts --schema ../../prisma/schema.prisma",
    "db:migrate:deploy": "node --env-file ../../.env ./node_modules/prisma/build/index.js migrate deploy --config ../../prisma.config.ts --schema ../../prisma/schema.prisma",
    "db:push": "node --env-file ../../.env ./node_modules/prisma/build/index.js db push --config ../../prisma.config.ts --schema ../../prisma/schema.prisma",
    "db:seed": "node --env-file ../../.env --import ./node_modules/tsx/dist/loader.mjs ../../prisma/seed.ts",
    "db:studio": "node --env-file ../../.env ./node_modules/prisma/build/index.js studio --config ../../prisma.config.ts --schema ../../prisma/schema.prisma",
    "db:reset": "node --env-file ../../.env ./node_modules/prisma/build/index.js migrate reset --force --config ../../prisma.config.ts --schema ../../prisma/schema.prisma",
    "db:format": "node --env-file ../../.env ./node_modules/prisma/build/index.js format --config ../../prisma.config.ts --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nova/shared-types": "workspace:*",
    "@nova/validation": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "argon2": "^0.43.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@nova/eslint-config": "workspace:*",
    "@nova/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.24",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.32.0",
    "prisma": "^7.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
