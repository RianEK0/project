  dimensionUom               UnitOfMeasure?         @relation("ProductDimensionUom", fields: [dimensionUomId], references: [id], onDelete: SetNull)
  volumeUom                  UnitOfMeasure?         @relation("ProductVolumeUom", fields: [volumeUomId], references: [id], onDelete: SetNull)
  variants                   ProductVariant[]
  images                     ProductImage[]
  attachments                ProductAttachment[]
  suppliers                  ProductSupplier[]
  bundle                     ProductBundle?
