  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  waveNumber     String
  warehouseId    String               @db.Uuid
  status         PickingWaveStatus    @default(DRAFT)
  strategy       PickingWaveStrategy
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdById    String               @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          PickingTask[]

  @@unique([organizationId, waveNumber])
  @@index([organizationId, status])
  @@index([warehouseId, scheduledAt])
}

model PickingTask {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  pickingWaveId   String?           @db.Uuid
  goodsIssueId    String?           @db.Uuid
  stockTransferId String?           @db.Uuid
  taskNumber      String
  warehouseId     String            @db.Uuid
  status          PickingTaskStatus @default(PENDING)
  priority        MovementPriority  @default(NORMAL)
  assignedToId    String?           @db.Uuid
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pickingWave     PickingWave?      @relation(fields: [pickingWaveId], references: [id], onDelete: SetNull)
  items           PickingTaskItem[]

  @@unique([organizationId, taskNumber])
  @@index([organizationId, status])
  @@index([warehouseId, priority])
}

model PickingTaskItem {
  id                        String            @id @default(uuid()) @db.Uuid
  organizationId            String            @db.Uuid
  pickingTaskId             String            @db.Uuid
  productVariantId          String            @db.Uuid
  requestedQuantity         Decimal           @db.Decimal(18, 4)
  allocatedQuantity         Decimal           @db.Decimal(18, 4)
  pickedQuantity            Decimal           @default(0) @db.Decimal(18, 4)
  uomId                     String            @db.Uuid
  sourceLocationId          String            @db.Uuid
  lotId                     String?           @db.Uuid
  serialId                  String?           @db.Uuid
  destinationStagingLocationId String?        @db.Uuid
  status                    PickingTaskStatus @default(PENDING)
  sequence                  Int
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pickingTask               PickingTask       @relation(fields: [pickingTaskId], references: [id], onDelete: Cascade)

  @@unique([pickingTaskId, sequence])
  @@index([organizationId, productVariantId])
}

model PackingSession {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  packingNumber     String
  goodsIssueId      String?              @db.Uuid
  stockTransferId   String?              @db.Uuid
  warehouseId       String               @db.Uuid
  packingLocationId String               @db.Uuid
  status            PackingSessionStatus @default(DRAFT)
  packedById        String?              @db.Uuid
  startedAt         DateTime?
  completedAt       DateTime?
  packageCount      Int                  @default(0)
  totalWeight       Decimal?             @db.Decimal(18, 4)
  weightUomId       String?              @db.Uuid
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items             PackingItem[]

  @@unique([organizationId, packingNumber])
  @@index([organizationId, status])
}

model PackingItem {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  packingSessionId String        @db.Uuid
  productVariantId String        @db.Uuid
  lotId            String?       @db.Uuid
  serialId         String?       @db.Uuid
  quantity         Decimal       @db.Decimal(18, 4)
  uomId            String        @db.Uuid
  packageNumber    String?
  createdAt        DateTime      @default(now())
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packingSession   PackingSession @relation(fields: [packingSessionId], references: [id], onDelete: Cascade)

  @@index([packingSessionId])
  @@index([organizationId, productVariantId])
}

model DispatchRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  dispatchNumber       String
  goodsIssueId         String?              @db.Uuid
  stockTransferShipmentId String?           @db.Uuid
  warehouseId          String               @db.Uuid
  dispatchLocationId   String               @db.Uuid
  status               DispatchRecordStatus @default(DRAFT)
  carrierName          String?
  vehicleNumber        String?
  driverName           String?
  trackingNumber       String?
  dispatchedAt         DateTime?
  dispatchedById       String?              @db.Uuid
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dispatchNumber])
  @@index([organizationId, status])
}

model InventoryAllocation {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @db.Uuid
  allocationNumber  String
  sourceType        InventoryMovementSourceType
  sourceId          String
  warehouseId       String                    @db.Uuid
  productVariantId  String                    @db.Uuid
  requestedQuantity Decimal                   @db.Decimal(18, 4)
  allocatedQuantity Decimal                   @default(0) @db.Decimal(18, 4)
  uomId             String                    @db.Uuid
  strategy          InventoryAllocationStrategy
  status            InventoryAllocationStatus @default(PENDING)
  expiresAt         DateTime?
  allocatedById     String?                   @db.Uuid
  reservationId     String?                   @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, allocationNumber])
  @@index([organizationId, status])
  @@index([warehouseId, productVariantId])
}

model WarehouseTask {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  taskNumber     String
  taskType       WarehouseTaskType
  warehouseId    String              @db.Uuid
  sourceType     String
  sourceId       String
  status         WarehouseTaskStatus @default(PENDING)
  priority       MovementPriority    @default(NORMAL)
  assignedToId   String?             @db.Uuid
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    WarehouseTaskAssignment[]

  @@unique([organizationId, taskNumber])
  @@index([organizationId, status])
  @@index([warehouseId, dueAt])
}

model WarehouseTaskAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  warehouseTaskId String        @db.Uuid
  assignedUserId String         @db.Uuid
  assignedAt     DateTime       @default(now())
  unassignedAt   DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseTask  WarehouseTask  @relation(fields: [warehouseTaskId], references: [id], onDelete: Cascade)

  @@index([warehouseTaskId, assignedAt])
}

model InventoryMovementReversal {
  id                String                           @id @default(uuid()) @db.Uuid
  organizationId    String                           @db.Uuid
  reversalNumber    String
  originalMovementId String                          @unique @db.Uuid
  reversalMovementId String?                         @unique @db.Uuid
  reason            String
  status            InventoryMovementReversalStatus  @default(DRAFT)
  requestedById     String                           @db.Uuid
  approvedById      String?                          @db.Uuid
  postedById        String?                          @db.Uuid
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  organization      Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originalMovement  InventoryMovement                @relation("MovementReversalOriginal", fields: [originalMovementId], references: [id], onDelete: Cascade)
  reversalMovement  InventoryMovement?               @relation("MovementReversalGenerated", fields: [reversalMovementId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reversalNumber])
  @@index([organizationId, status])
}

model StockCountSession {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  countNumber    String
  warehouseId    String           @db.Uuid
  countType      StockCountType
  status         StockCountStatus @default(DRAFT)
  scopeType      StockCountScopeType
  scopeIds       Json?
  freezeStock    Boolean          @default(false)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  approvedAt     DateTime?
  createdById    String           @db.Uuid
  approvedById   String?          @db.Uuid
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          StockCountLine[]

  @@unique([organizationId, countNumber])
  @@index([organizationId, status])
  @@index([warehouseId, scheduledAt])
}

model StockCountLine {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  stockCountSessionId String       @db.Uuid
  productVariantId  String         @db.Uuid
  storageLocationId String         @db.Uuid
  lotId             String?        @db.Uuid
  serialId          String?        @db.Uuid
  systemQuantity    Decimal        @db.Decimal(18, 4)
  countedQuantity   Decimal?       @db.Decimal(18, 4)
  varianceQuantity  Decimal?       @db.Decimal(18, 4)
  uomId             String         @db.Uuid
  countedById       String?        @db.Uuid
  countedAt         DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockCountSession StockCountSession @relation(fields: [stockCountSessionId], references: [id], onDelete: Cascade)

  @@index([stockCountSessionId])
  @@index([organizationId, productVariantId])
}

model ScanSession {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  sessionNumber  String
  userId         String            @db.Uuid
  warehouseId    String            @db.Uuid
  taskType       WarehouseTaskType?
  taskId         String?           @db.Uuid
  status         ScanSessionStatus @default(ACTIVE)
  startedAt      DateTime
  completedAt    DateTime?
  deviceInfo     Json?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         ScanEvent[]

  @@unique([organizationId, sessionNumber])
  @@index([organizationId, userId, status])
}

model ScanEvent {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  scanSessionId      String       @db.Uuid
  scanType           ScanType
  scannedValue       String
  resolvedEntityType String?
  resolvedEntityId   String?      @db.Uuid
  success            Boolean
  errorCode          String?
  metadata           Json?
  scannedAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanSession        ScanSession  @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)

  @@index([scanSessionId, scannedAt])
  @@index([organizationId, scanType])
}
