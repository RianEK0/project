model UnitOfMeasure {
  id                     String                        @id @default(uuid()) @db.Uuid
  organizationId         String?                       @db.Uuid
  name                   String
  symbol                 String
  code                   String                        @unique
  category               UomCategory
  dimension              UomDimension
  precision              Int                           @default(2)
  isBaseUnit             Boolean                       @default(false)
  isSystem               Boolean                       @default(false)
  status                 UomStatus                     @default(ACTIVE)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  deletedAt              DateTime?
  organization           Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversionsFrom        UnitConversion[]              @relation("UnitConversionFrom")
  conversionsTo          UnitConversion[]              @relation("UnitConversionTo")
  productsAsDefaultUom   Product[]                     @relation("ProductDefaultUom")
  productsAsPurchaseUom  Product[]                     @relation("ProductPurchaseUom")
  productsAsSalesUom     Product[]                     @relation("ProductSalesUom")
  productsAsWeightUom    Product[]                     @relation("ProductWeightUom")
  productsAsDimensionUom Product[]                     @relation("ProductDimensionUom")
  productsAsVolumeUom    Product[]                     @relation("ProductVolumeUom")
  variantsAsDefaultUom   ProductVariant[]              @relation("ProductVariantDefaultUom")
  variantsAsPurchaseUom  ProductVariant[]              @relation("ProductVariantPurchaseUom")
  variantsAsSalesUom     ProductVariant[]              @relation("ProductVariantSalesUom")
  variantsAsWeightUom    ProductVariant[]              @relation("ProductVariantWeightUom")
  variantsAsDimensionUom ProductVariant[]              @relation("ProductVariantDimensionUom")
  variantsAsVolumeUom    ProductVariant[]              @relation("ProductVariantVolumeUom")
  bundleItems            ProductBundleItem[]           @relation("ProductBundleItemUom")
  supplierLinks          ProductSupplier[]             @relation("ProductSupplierPurchaseUom")
  storageLocations       StorageLocation[]             @relation("StorageLocationWeightUom")
  inventoryItems         InventoryItem[]               @relation("InventoryItemStockingUom")
  inventoryBalances      InventoryBalance[]            @relation("InventoryBalanceUom")
  inventoryReservations  InventoryReservation[]        @relation("InventoryReservationUom")
  openingBalanceItems    InventoryOpeningBalanceItem[] @relation("InventoryOpeningBalanceItemUom")

  @@index([organizationId, status])
  @@index([deletedAt])
}

model UnitConversion {
