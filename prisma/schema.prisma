  toUom           UnitOfMeasure @relation("UnitConversionTo", fields: [toUomId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromUomId, toUomId])
  @@index([fromUomId, toUomId])
  @@index([deletedAt])
}

model Product {
