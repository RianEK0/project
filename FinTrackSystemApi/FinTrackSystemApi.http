@baseUrl = http://localhost:5042
@token = paste-jwt-token-here

### Login Super Admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

### Get Customers
GET {{baseUrl}}/api/customers
Authorization: Bearer {{token}}

### Create Customer
POST {{baseUrl}}/api/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Tasya Amelia",
  "accountNumber": "100110012099",
  "email": "tasya.amelia@example.com",
  "phoneNumber": "081234567899",
  "address": "Jl. Merdeka No. 10, Jakarta",
  "status": "Active"
}

### Get Transactions
GET {{baseUrl}}/api/transactions?status=Pending&type=Transfer
Authorization: Bearer {{token}}

### Create Transaction
POST {{baseUrl}}/api/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": "00000000-0000-0000-0000-000000000000",
  "transactionType": "Transfer",
  "amount": 2500000,
  "status": "Pending",
  "transactionDate": "2026-05-15",
  "description": "Transfer demo via API"
}

### Approve Transaction
PUT {{baseUrl}}/api/transactions/00000000-0000-0000-0000-000000000000/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "note": "Approved from API test."
}

### Reject Transaction
PUT {{baseUrl}}/api/transactions/00000000-0000-0000-0000-000000000000/reject
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "note": "Rejected from API test."
}

### Report Transactions
GET {{baseUrl}}/api/reports/transactions?dateFrom=2026-05-01&dateTo=2026-05-31&status=Success&auditExport=true
Authorization: Bearer {{token}}

### Audit Logs
GET {{baseUrl}}/api/audit-logs
Authorization: Bearer {{token}}
