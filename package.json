{
  "name": "sipadi",
  "private": true,
  "version": "1.0.0",
  "description": "SIPADI - Sistem Pengarsipan dan Disposisi Inspektorat",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @sipadi/api\" \"npm run dev --workspace @sipadi/web\"",
    "dev:api": "npm run dev --workspace @sipadi/api",
    "dev:web": "npm run dev --workspace @sipadi/web",
    "db:schema": "npm run schema --workspace @sipadi/api",
    "db:seed": "npm run seed --workspace @sipadi/api",
    "test": "node --test apps/api/test/*.test.js",
    "lint": "npm run lint --workspace @sipadi/web",
    "ci": "npm test && npm run security:static && npm run lint && npm run build --workspace @sipadi/web",
    "security:smoke": "node scripts/security-smoke.mjs",
    "security:preflight": "node scripts/go-live-preflight.mjs",
    "security:static": "node scripts/security-static-check.mjs",
    "security:generate-secrets": "node scripts/generate-security-secrets.mjs",
    "start": "npm run start --workspace @sipadi/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "react-select": "^5.10.2"
  }
}
