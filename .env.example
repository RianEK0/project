NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_HOST=0.0.0.0

NEXT_PUBLIC_APP_NAME=NovaERP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novaerp?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-strong-secret-too
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_NAME=novaerp_refresh_token
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@novaerp.local
SMTP_FROM_NAME=NovaERP

EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
INVITATION_EXPIRES_IN=7d

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=20

LOG_LEVEL=debug
