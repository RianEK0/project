# Salin ke .env di root repo sebelum menjalankan docker-compose.security.yml.
POSTGRES_DB=sipadi
POSTGRES_USER=sipadi
POSTGRES_PASSWORD=ganti-password-database-yang-panjang
JWT_SECRET=ganti-secret-acak-minimal-32-karakter
SESSION_COOKIE_HOURS=8
MFA_ENCRYPTION_KEY=ganti-dengan-output-openssl-rand-base64-32
MFA_ENCRYPTION_KEY_ID=mfa-v1
MFA_PREVIOUS_ENCRYPTION_KEYS=
RECOVERY_CODE_PEPPER=ganti-dengan-secret-acak-berbeda-minimal-32-karakter
MFA_REQUIRED_ROLES=Admin,Inspektur
PASSKEY_REQUIRED_ROLES=Admin,Inspektur
WEBAUTHN_RP_ID=sipadi.example.go.id
WEBAUTHN_RP_NAME=SIPADI Inspektorat Kota Depok
WEBAUTHN_ORIGINS=https://sipadi.example.go.id
AUDIT_SIGNING_KEY=ganti-dengan-secret-acak-khusus-audit-minimal-32-karakter
AUDIT_SIGNING_KEY_ID=audit-v1
AUDIT_PREVIOUS_SIGNING_KEYS=
METRICS_ENABLED=true
METRICS_TOKEN=ganti-token-metrics-acak-minimal-32-karakter
BACKUP_ENCRYPTION_KEY=ganti-dengan-output-openssl-rand-base64-32-yang-berbeda
BACKUP_ENCRYPTION_KEY_ID=backup-v1
BACKUP_PREVIOUS_ENCRYPTION_KEYS=
MAX_BACKUP_FILE_SIZE_MB=100
FILE_ENCRYPTION_KEY=ganti-dengan-output-openssl-rand-base64-32-khusus-file
FILE_ENCRYPTION_KEY_ID=file-v1
FILE_PREVIOUS_ENCRYPTION_KEYS=
FILE_ENCRYPTION_REQUIRED=true
ALLOW_PLAINTEXT_STORED_FILES=false
FILE_STORAGE_DRIVER=s3
FILE_S3_BUCKET=sipadi-files-production
FILE_S3_REGION=ap-southeast-1
FILE_S3_PREFIX=sipadi/files
FILE_S3_ENDPOINT=
FILE_S3_FORCE_PATH_STYLE=false
FILE_S3_KMS_KEY_ID=arn:aws:kms:ap-southeast-1:000000000000:key/ganti-dengan-key-id-final
FILE_STORAGE_VERIFY_BUCKET_CONTROLS=true

# Domain publik yang melewati WAF. Gunakan HTTPS di production.
SERVER_NAME=sipadi.example.go.id
APP_ORIGIN=https://sipadi.example.go.id
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_BASE64=
DATABASE_PRIVATE_NETWORK_ACKNOWLEDGED=true
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
AGENCY_NAME=Inspektorat Kota Depok
SECURITY_CONTACT=mailto:csirt@example.go.id
# Ubah true hanya setelah naskah kebijakan disahkan dan semua placeholder diganti.
POLICY_APPROVED=false
# Gerbang bukti berikut tetap false sampai diverifikasi pejabat/penanggung jawab.
WAF_PRODUCTION_VERIFIED=false
ORIGIN_LOCKDOWN_VERIFIED=false
SIEM_ALERT_VERIFIED=false
EDR_COVERAGE_VERIFIED=false
COSIGN_IMAGES_VERIFIED=false
RESTORE_DRILL_PASSED=false
INCIDENT_TABLETOP_PASSED=false
PASSKEY_PRIVILEGED_OFFICERS=0
VAPT_HIGH_CRITICAL_OPEN=-1
VAPT_REPORT_SHA256=
RESTORE_DRILL_EVIDENCE_ID=
HTTP_PORT=80
HTTPS_PORT=443
TLS_REDIRECT=on

JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
TRUST_PROXY_HOPS=2
MAX_FILE_SIZE_MB=10
MAX_IMPORT_FILE_SIZE_MB=2
CLAMAV_TIMEOUT_MS=30000

# Backup offsite S3-compatible dengan versioning dan Object Lock aktif.
BACKUP_S3_BUCKET=sipadi-backup-production
BACKUP_S3_REGION=ap-southeast-1
BACKUP_S3_PREFIX=sipadi
BACKUP_S3_ENDPOINT=
BACKUP_S3_OBJECT_LOCK_DAYS=30

# State auto-block terdistribusi; Fail2ban di host menjadi lapisan tambahan.
SECURITY_STATE_REQUIRED=true
SECURITY_STATE_REDIS_PASSWORD=ganti-password-valkey-acak-minimal-32-karakter
SECURITY_STATE_REDIS_URL=redis://:ganti-password-valkey-acak-minimal-32-karakter@security-state:6379/0
SECURITY_STATE_KEY_PREFIX=sipadi:security
SECURITY_BLOCK_THRESHOLD=5
SECURITY_STRIKE_WINDOW_MINUTES=15
SECURITY_BLOCK_DURATION_MINUTES=60
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_WINDOW_MINUTES=15
ACCOUNT_LOCK_DURATION_MINUTES=15
PASSWORD_HISTORY_COUNT=5
PRIVILEGED_REAUTH_MAX_AGE_MINUTES=15
CRITICAL_APPROVAL_TTL_MINUTES=30
DATA_EGRESS_WINDOW_MINUTES=15
DATA_EGRESS_ALERT_THRESHOLD=20
DATA_EGRESS_BLOCK_THRESHOLD=40
DATA_EGRESS_BLOCK_MINUTES=60
SESSION_IDLE_TIMEOUT_MINUTES=30
MAX_ACTIVE_SESSIONS=3
