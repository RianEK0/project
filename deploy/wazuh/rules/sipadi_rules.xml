<group name="sipadi,application_security,">
  <rule id="100100" level="5">
    <decoded_as>sipadi-security</decoded_as>
    <description>SIPADI security event: $(type) from $(ipAddress)</description>
  </rule>

  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="severity" type="pcre2">^(high|critical)$</field>
    <description>High severity SIPADI event: $(type) from $(ipAddress)</description>
  </rule>

  <rule id="100102" level="12" frequency="5" timeframe="900">
    <if_matched_sid>100100</if_matched_sid>
    <field name="type" type="pcre2">^(LOGIN_FAILED|LOGIN_RATE_LIMIT|ACCOUNT_LOGIN_LOCKED|MFA_VERIFICATION_FAILED|MFA_RATE_LIMIT|PASSKEY_STEP_UP_FAILED|INVALID_ACCESS_TOKEN|LEGACY_SESSION_REJECTED|REVOKED_SESSION_REUSE|REVOKED_TOKEN_REUSE|CROSS_SITE_MUTATION_BLOCKED|PATH_TRAVERSAL|XSS_PROBE|SQL_INJECTION_PROBE|COMMAND_INJECTION_PROBE|NULL_BYTE_PROBE|HONEYPOT_TRIGGERED)$</field>
    <same_field>ipAddress</same_field>
    <description>Repeated SIPADI attacks from $(ipAddress)</description>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <rule id="100104" level="7">
    <if_sid>100100</if_sid>
    <field name="type">CONCURRENT_SESSION_LIMIT_ENFORCED</field>
    <description>SIPADI concurrent session limit enforced for user $(userId)</description>
    <group>session_monitoring,</group>
  </rule>

  <rule id="100105" level="12" frequency="3" timeframe="900">
    <if_matched_sid>100104</if_matched_sid>
    <same_field>userId</same_field>
    <description>Repeated SIPADI concurrent session limits for user $(userId)</description>
    <group>session_monitoring,possible_account_sharing,</group>
  </rule>

  <rule id="100106" level="3">
    <if_sid>100100</if_sid>
    <field name="type">SESSION_EXPIRED</field>
    <description>SIPADI session expired normally for user $(userId)</description>
    <group>session_monitoring,</group>
  </rule>

  <rule id="100103" level="14">
    <if_sid>100100</if_sid>
    <field name="type" type="pcre2">^(MALWARE_UPLOAD_BLOCKED|HONEYPOT_TRIGGERED|ADMIN_MFA_RESET)$</field>
    <description>Critical SIPADI security action: $(type)</description>
    <group>malware,account_changed,</group>
  </rule>

  <rule id="100107" level="15">
    <if_sid>100100</if_sid>
    <field name="type" type="pcre2">^(DATA_EXFILTRATION_BLOCKED|FILE_ENCRYPTION_FAILED|STORED_FILE_INTEGRITY_FAILED)$</field>
    <description>Critical SIPADI data protection event: $(type) for user $(userId)</description>
    <group>data_loss_prevention,file_integrity,</group>
  </rule>

  <rule id="100108" level="12">
    <if_sid>100100</if_sid>
    <field name="type" type="pcre2">^(DATA_EXFILTRATION_ANOMALY|PLAINTEXT_STORED_FILE_BLOCKED|CRITICAL_APPROVAL_REQUESTED|CRITICAL_APPROVAL_REJECTED)$</field>
    <description>SIPADI privileged/data anomaly: $(type) for user $(userId)</description>
    <group>data_loss_prevention,privileged_action,</group>
  </rule>

  <rule id="100110" level="10">
    <decoded_as>sipadi-security-store-failed</decoded_as>
    <description>SIPADI could not persist a security event</description>
  </rule>

  <rule id="100111" level="15">
    <decoded_as>sipadi-startup-security-failure</decoded_as>
    <description>SIPADI refused startup because a mandatory security control was unavailable</description>
    <group>availability,configuration,security_control_failure,</group>
  </rule>
</group>
